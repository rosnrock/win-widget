<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="WidgetFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="WidgetTextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <SolidColorBrush x:Key="WidgetTextBrush" Color="#E8EDF9" />
    <SolidColorBrush x:Key="WidgetSurfaceBrush" Color="#D9162A52" />

    <Style x:Key="WidgetSurface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WidgetSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="32" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="BorderBrush" Value="#52A9C4F5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource WidgetTextBrush}" />
    </Style>

    <Style x:Key="WidgetLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WidgetTextFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="WidgetEyebrow" TargetType="TextBlock" BasedOn="{StaticResource WidgetLabel}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Opacity" Value="0.78" />
    </Style>

    <Style x:Key="SettingsButton" TargetType="Button">
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="#FFF3F4F7" />
        <Setter Property="BorderBrush" Value="#1A000000" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource WidgetTextFont}" />
    </Style>

    <Style x:Key="AppearanceLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WidgetTextFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#B8202124" />
    </Style>

    <Style x:Key="ColorSwatch" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,9,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderBrush" Value="#20000000" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="15"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.78" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.58" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
