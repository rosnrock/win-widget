<Window x:Class="WinWidget.Views.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinWidget.Views"
        Title="WinWidget" Width="860" Height="720" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#FFF5F6F8"
        FontFamily="{StaticResource WidgetTextFont}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource SettingsButton}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF23478B" />
            <Setter Property="BorderBrush" Value="#FF23478B" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Виджеты" FontSize="27" FontWeight="SemiBold" Foreground="#FF202124" />
                <TextBlock Margin="0,5,0,0" Text="Добавляйте и настраивайте элементы рабочего стола"
                           FontSize="13" Foreground="#A6202124" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="AddButton" Content="＋  Добавить" Style="{StaticResource PrimaryButton}"
                    Height="40" MinWidth="126" Click="OnAddClick">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Дата и время" Tag="Clock" Click="OnAddWidgetClick" />
                        <MenuItem Header="Календарь" Tag="Calendar" Click="OnAddWidgetClick" />
                        <MenuItem Header="Текстовая заметка" Tag="Notes" Click="OnAddWidgetClick" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="16" BorderBrush="#14000000" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="WidgetList" BorderThickness="0" Background="Transparent"
                             SelectionChanged="OnSelectionChanged" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5,7" MinHeight="42">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding KindLabel}" Margin="0,3,0,0" FontSize="11" Foreground="#90202124" />
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="10" Padding="9,3" VerticalAlignment="Center"
                                            Background="{Binding StatusBackground}">
                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{Binding StatusForeground}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <WrapPanel Grid.Row="1" Margin="5,12,0,3">
                        <Button x:Name="VisibilityButton" Content="Скрыть" Click="OnVisibilityClick" />
                        <Button Content="Найти на экране" Click="OnFindClick" />
                        <Button Content="Удалить" Click="OnDeleteClick" Foreground="#FFC74645" />
                    </WrapPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Оформление" Margin="2,0,0,10" FontSize="16" FontWeight="SemiBold" Foreground="#FF202124" />
                <views:AppearancePanel x:Name="AppearancePanel" AppearanceChanged="OnAppearanceChanged" />
                <TextBlock x:Name="NoSelectionHint" Margin="3,14,0,0" TextWrapping="Wrap"
                           Text="Выберите виджет слева, чтобы изменить его цвета и прозрачность."
                           Foreground="#90202124" FontSize="12" />
                <Border Margin="0,18,0,0" Padding="16" Background="White" CornerRadius="14"
                        BorderBrush="#14000000" BorderThickness="1">
                    <StackPanel>
                        <CheckBox x:Name="SnapToGridCheckBox" Content="Привязывать к сетке"
                                  Checked="OnSnapToGridChanged" Unchecked="OnSnapToGridChanged" />
                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Шаг сетки" VerticalAlignment="Center" Foreground="#B0202124" />
                            <ComboBox x:Name="GridSizeComboBox" Grid.Column="1" SelectionChanged="OnGridSizeChanged">
                                <ComboBoxItem Content="8 px" Tag="8" />
                                <ComboBoxItem Content="16 px" Tag="16" />
                                <ComboBoxItem Content="24 px" Tag="24" />
                                <ComboBoxItem Content="32 px" Tag="32" />
                            </ComboBox>
                        </Grid>
                        <Button Margin="0,13,0,0" Content="Выровнять все" Click="OnAlignAllClick" />
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
