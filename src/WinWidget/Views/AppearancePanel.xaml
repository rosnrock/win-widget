<UserControl x:Class="WinWidget.Views.AppearancePanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 MinWidth="270" MaxWidth="300" FontFamily="{StaticResource WidgetTextFont}">
 <UserControl.Resources>
  <Style x:Key="ValueBox" TargetType="TextBox"><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="6,3"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#28000000"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="TargetButton" TargetType="RadioButton">
   <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Box" Padding="10,7" CornerRadius="8" Background="#FFF3F4F7" BorderBrush="#18000000" BorderThickness="1">
     <StackPanel Orientation="Horizontal"><Border Width="18" Height="18" CornerRadius="4" Margin="0,0,7,0" Background="{TemplateBinding Background}" BorderBrush="#30000000" BorderThickness="1"/><ContentPresenter VerticalAlignment="Center"/></StackPanel>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#FF23478B"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Border Padding="18" CornerRadius="18" Background="#FAFFFFFF" BorderBrush="#16000000" BorderThickness="1">
  <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.14"/></Border.Effect>
  <StackPanel>
   <TextBlock x:Name="PanelTitle" Text="Appearance" FontSize="15" FontWeight="SemiBold" Foreground="#FF202124"/>
   <TextBlock Margin="0,15,0,7" Text="Editing" Style="{StaticResource AppearanceLabel}"/>
   <StackPanel Orientation="Horizontal">
    <RadioButton x:Name="TextTarget" Content="Text" IsChecked="True" Style="{StaticResource TargetButton}" Checked="OnTargetChanged"/>
    <RadioButton x:Name="BackgroundTarget" Content="Background" Style="{StaticResource TargetButton}" Checked="OnTargetChanged"/>
   </StackPanel>

   <TextBlock Margin="0,14,0,7" Text="Color" Style="{StaticResource AppearanceLabel}"/>
   <Grid Height="166">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
    <Canvas x:Name="SvCanvas" Margin="0,0,10,0" ClipToBounds="True" Cursor="Cross"
            MouseLeftButtonDown="OnSvMouseDown" MouseMove="OnSvMouseMove" MouseLeftButtonUp="OnPickerMouseUp" SizeChanged="OnPickerSizeChanged">
     <Rectangle x:Name="HueSurface" Width="{Binding ActualWidth, ElementName=SvCanvas}" Height="{Binding ActualHeight, ElementName=SvCanvas}"/>
     <Rectangle Width="{Binding ActualWidth, ElementName=SvCanvas}" Height="{Binding ActualHeight, ElementName=SvCanvas}">
      <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
     </Rectangle>
     <Rectangle Width="{Binding ActualWidth, ElementName=SvCanvas}" Height="{Binding ActualHeight, ElementName=SvCanvas}">
      <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
     </Rectangle>
     <Ellipse x:Name="SvMarker" Width="14" Height="14" Stroke="White" StrokeThickness="2" Fill="Transparent"><Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8"/></Ellipse.Effect></Ellipse>
    </Canvas>
    <Canvas x:Name="HueCanvas" Grid.Column="1" Cursor="Hand" MouseLeftButtonDown="OnHueMouseDown" MouseMove="OnHueMouseMove" MouseLeftButtonUp="OnPickerMouseUp" SizeChanged="OnPickerSizeChanged">
     <Rectangle Width="{Binding ActualWidth, ElementName=HueCanvas}" Height="{Binding ActualHeight, ElementName=HueCanvas}" RadiusX="4" RadiusY="4">
      <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFF0000" Offset="0"/><GradientStop Color="#FFFFFF00" Offset=".167"/><GradientStop Color="#FF00FF00" Offset=".333"/><GradientStop Color="#FF00FFFF" Offset=".5"/><GradientStop Color="#FF0000FF" Offset=".667"/><GradientStop Color="#FFFF00FF" Offset=".833"/><GradientStop Color="#FFFF0000" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
     </Rectangle>
     <Rectangle x:Name="HueMarker" Height="4" Stroke="White" StrokeThickness="2" Fill="Transparent" Width="{Binding ActualWidth, ElementName=HueCanvas}"/>
    </Canvas>
   </Grid>

   <Grid Margin="0,12,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="ColorPreview" Width="26" Height="26" CornerRadius="5" BorderBrush="#30000000" BorderThickness="1"/>
    <TextBox x:Name="ColorR" Grid.Column="1" Margin="0,0,5,0" Style="{StaticResource ValueBox}" TextChanged="OnRgbChanged" ToolTip="Red, 0–255"/>
    <TextBox x:Name="ColorG" Grid.Column="2" Margin="0,0,5,0" Style="{StaticResource ValueBox}" TextChanged="OnRgbChanged" ToolTip="Green, 0–255"/>
    <TextBox x:Name="ColorB" Grid.Column="3" Margin="0,0,5,0" Style="{StaticResource ValueBox}" TextChanged="OnRgbChanged" ToolTip="Blue, 0–255"/>
    <TextBox x:Name="ColorHex" Grid.Column="4" Style="{StaticResource ValueBox}" TextChanged="OnHexChanged" ToolTip="HEX, #RRGGBB"/>
   </Grid>
   <Grid Margin="32,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="R" Style="{StaticResource AppearanceLabel}"/><TextBlock Grid.Column="1" Text="G" Style="{StaticResource AppearanceLabel}"/><TextBlock Grid.Column="2" Text="B" Style="{StaticResource AppearanceLabel}"/><TextBlock Grid.Column="3" Text="HEX" Style="{StaticResource AppearanceLabel}"/></Grid>
   <TextBlock x:Name="ColorError" Margin="32,3,0,0" Foreground="#FFC62828" FontSize="11" Visibility="Collapsed"/>

   <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
    <TextBlock Text="Background opacity" VerticalAlignment="Center" Style="{StaticResource AppearanceLabel}"/>
    <Slider x:Name="OpacitySlider" Grid.Column="1" Margin="13,0,9,0" Minimum="0" Maximum="100" TickFrequency="5" ValueChanged="OnOpacityChanged"/>
    <TextBlock x:Name="OpacityLabel" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" Foreground="#A6202124" FontSize="12"/>
   </Grid>
  </StackPanel>
 </Border>
</UserControl>
