<UserControl x:Class="WinWidget.Views.NotesWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinWidth="220" MinHeight="92">
        <TextBlock x:Name="Placeholder" Margin="3,2" Text="Write a note…"
                   FontFamily="{StaticResource WidgetTextFont}" FontSize="16"
                   FontWeight="SemiBold" Opacity="0.42"
                   Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                   IsHitTestVisible="False" />
        <TextBox x:Name="Editor" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="0"
                 Background="Transparent"
                 Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                 CaretBrush="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                 FontFamily="{StaticResource WidgetTextFont}" FontSize="16" FontWeight="SemiBold"
                 TextChanged="OnTextChanged" />
    </Grid>
</UserControl>
