<UserControl x:Class="WinWidget.Views.NotesWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinWidth="220" MinHeight="92">
        <TextBlock x:Name="Placeholder" Margin="3,34,3,2" Text="Write something…"
                   FontFamily="{StaticResource WidgetTextFont}" FontSize="18"
                   FontWeight="SemiBold" Opacity="0.38"
                   Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                   IsHitTestVisible="False" />
        <TextBox x:Name="Editor" AcceptsReturn="True" TextWrapping="Wrap"
                 Margin="0,32,0,0" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="0"
                 Background="Transparent"
                 Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                 CaretBrush="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                 FontFamily="{StaticResource WidgetTextFont}" FontSize="18" FontWeight="SemiBold"
                 TextBlock.LineHeight="25"
                 TextChanged="OnTextChanged" />
        <Border x:Name="DragHandle" Width="48" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeAll"
                Background="Transparent" ToolTip="Drag note"
                MouseLeftButtonDown="OnDragHandleMouseDown">
            <TextBlock Text="•••" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="16" FontWeight="Bold" Opacity="0.28"
                       Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0.35" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
